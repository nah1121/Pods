<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Pods</AssemblyName>
    <RootNamespace>Pods.App</RootNamespace>
    <ApplicationIcon>Assets\Pods.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pods.Core\Pods.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Pods.ico" />
    <Content Include="Assets\icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared design system, linked so the pack URI is /Theme.xaml here and in
         the frame monitor. -->
    <Resource Include="..\Shared\Theme.xaml">
      <Link>Theme.xaml</Link>
    </Resource>
  </ItemGroup>

</Project>
