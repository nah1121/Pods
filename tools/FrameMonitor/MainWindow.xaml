<Window x:Class="FrameMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pods - live frame monitor" Height="880" Width="1240"
        MinHeight="680" MinWidth="1040"
        Background="#0B0D12" Foreground="#E8ECF3"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#F04438"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText" Text="Connecting..." Style="{StaticResource Dim}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Frames:" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="FrameCount" Text="0" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Pause" Content="Pause" Style="{StaticResource GhostButton}" Click="Pause_Click" Margin="0,0,8,0"/>
                <Button Content="Reconnect" Style="{StaticResource PrimaryButton}" Click="Reconnect_Click" Margin="0,0,8,0" Padding="14,7"/>
                <Button Content="Clear" Style="{StaticResource GhostButton}" Click="Clear_Click" Margin="0,0,8,0"/>
                <Button Content="Open log" Style="{StaticResource GhostButton}" Click="OpenLog_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Live frame stream -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="INBOUND FRAMES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Filter cmd:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterBox" Width="70" Height="24" VerticalAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" Padding="6,2"
                                     TextChanged="Filter_Changed"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="FrameList" Grid.Row="1"
                             Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                             Foreground="{StaticResource TextDimBrush}"
                             SelectionMode="Extended"
                             SelectionChanged="FrameList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Decoded live state -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LIVE STATE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="L" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Border Grid.Row="0" Grid.Column="1" Height="8" CornerRadius="4" Margin="8,0,8,0"
                                    Background="{StaticResource SurfaceHiBrush}" VerticalAlignment="Center">
                                <Rectangle x:Name="LeftBar" Width="0" Height="8" Fill="{StaticResource GoodBrush}" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LeftValue" Text="--"
                                       Style="{StaticResource Dim}" VerticalAlignment="Center" MinWidth="82"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="R" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Border Grid.Row="1" Grid.Column="1" Height="8" CornerRadius="4" Margin="8,8,8,0"
                                    Background="{StaticResource SurfaceHiBrush}" VerticalAlignment="Center">
                                <Rectangle x:Name="RightBar" Width="0" Height="8" Fill="{StaticResource GoodBrush}" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RightValue" Text="--"
                                       Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,8,0,0" MinWidth="82"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="C" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Border Grid.Row="2" Grid.Column="1" Height="8" CornerRadius="4" Margin="8,8,8,0"
                                    Background="{StaticResource SurfaceHiBrush}" VerticalAlignment="Center">
                                <Rectangle x:Name="CaseBar" Width="0" Height="8" Fill="{StaticResource GoodBrush}" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="CaseValue" Text="--"
                                       Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,8,0,0" MinWidth="82"/>
                        </Grid>
                        <TextBlock x:Name="BudStateText" Text="" Style="{StaticResource Dim}" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Tagging -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LABEL A CODE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Type what a frame means, then tag it. Select several frames to tag them all at once."/>

                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBox x:Name="LabelBox" Height="28" FontSize="12.5"
                                     Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderHiBrush}" Padding="8,4"
                                     KeyDown="LabelBox_KeyDown"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Tag selected" Style="{StaticResource PrimaryButton}"
                                        Click="TagSelected_Click" Padding="12,6" MinWidth="0"/>
                                <Button Content="Tag last" Style="{StaticResource GhostButton}"
                                        Click="Tag_Click" Padding="12,6" MinWidth="0" Margin="8,0,0,0"/>
                                <Button Content="Undo" Style="{StaticResource GhostButton}"
                                        Click="Undo_Click" Padding="12,6" MinWidth="0" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectionInfo" Style="{StaticResource Dim}" FontSize="11"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Click or ctrl/shift-click frames to select several, then Tag selected."/>
                            <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="A physical action often produces a burst of frames. Mark writes a timestamped note into the log, and Tag since mark labels every frame that arrived after the previous mark."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox x:Name="MarkBox" Height="26" FontSize="12" Width="170"
                                         Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderHiBrush}" Padding="8,3"
                                         KeyDown="MarkBox_KeyDown"/>
                                <Button Content="Mark" Style="{StaticResource GhostButton}"
                                        Click="Mark_Click" Padding="12,5" MinWidth="0" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Content="Tag since last mark" Style="{StaticResource GhostButton}"
                                    Click="TagSinceMark_Click" Padding="12,5" MinWidth="0" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Border Grid.Row="3" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="MapBox" Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                         BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11"
                                         VerticalScrollBarVisibility="Disabled" Padding="0"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Copy" Style="{StaticResource GhostButton}"
                                    Click="Copy_Click" Padding="12,5" MinWidth="0" Margin="0,0,8,0"/>
                            <Button Content="Save" Style="{StaticResource GhostButton}"
                                    Click="Save_Click" Padding="12,5" MinWidth="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FooterHint" Text="" Style="{StaticResource Dim}" Opacity="0.8"/>
            <TextBlock x:Name="LastFrame" Text="" Style="{StaticResource Mono}"
                       HorizontalAlignment="Right" Foreground="{StaticResource TextFaintBrush}"/>
        </Grid>
    </Grid>
</Window>